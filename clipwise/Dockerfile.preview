# Single-container preview: website + API + worker + MongoDB on one port.
# Self-contained on purpose - it needs no other file from this repo, so it can
# be dropped into a repository on its own.
FROM node:20-alpine AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci || npm install
COPY frontend/ ./
ENV REACT_APP_BACKEND_URL=""
ENV CI=false
RUN npm run build

FROM mongo:7
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-venv ffmpeg curl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
WORKDIR /app
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend/ /app/
COPY --from=web /web/build /app/frontend_dist

# ASGI wrapper that serves the built SPA from the same origin as the API,
# and the boot script that starts MongoDB before uvicorn. Both are base64 so
# this Dockerfile stays a single flat file with no embedded indentation.
RUN echo  | base64 -d > /app/serve_spa.py
RUN echo  | base64 -d > /usr/local/bin/preview-entrypoint.sh && chmod +x /usr/local/bin/preview-entrypoint.sh

ENV PYTHONUNBUFFERED=1
ENV FRONTEND_DIST=/app/frontend_dist
ENV RUN_JOBS_INLINE=true
ENV STORAGE_BACKEND=local
ENV LOCAL_STORAGE_DIR=/data/storage
ENV WORK_DIR=/data/work
ENV MONGO_URL=mongodb://127.0.0.1:27017
ENV SEED_DEMO=true
ENV PORT=8000
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/preview-entrypoint.sh"]
